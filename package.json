{
  "name": "india-utils",
  "version": "0.1.1",
  "description": "Zero-dependency validators and formatters for Indian identifiers and numbers (PAN, GSTIN, IFSC, INR).",
  "keywords": [
    "india",
    "pan",
    "gstin",
    "ifsc",
    "inr",
    "validation"
  ],
  "license": "MIT",
  "author": "Mayur Jogade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himayurjogade/india-utils.git"
  },
  "bugs": {
    "url": "https://github.com/himayurjogade/india-utils/issues"
  },
  "homepage": "https://github.com/himayurjogade/india-utils#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "attw": "attw --pack .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && changeset publish",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.0.0",
    "@changesets/cli": "^3.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
